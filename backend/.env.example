# Backend de demo: corre 100% en memoria, sin base de datos.
# Kapso, GenLayer (Gemini/Claude) e IPFS siguen simulados a proposito.

JWT_SECRET=change-me-in-production
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# WDK real (@tetherto/wdk-cli, Sepolia testnet) -- ver README.md "Setup de WDK".
# Sin esto configurado, los payouts fallan con un error claro (no fingen
# una transaccion).
WDK_WALLET_NAME=
WDK_PASSPHRASE=
WDK_NETWORK=sepolia
WDK_TOKEN=musdt
